; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Doomsday Train"
run/main_scene="res://scenes/run_main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

ConfigDb="*res://scripts/data/config_db.gd"
LocaleDb="*res://scripts/data/locale_db.gd"
RngService="*res://scripts/data/rng_service.gd"
TelemetryService="*res://scripts/data/telemetry_service.gd"
SaveService="*res://scripts/data/save_service.gd"
IntentBus="*res://scripts/app/intent_bus.gd"
GameSession="*res://scripts/app/game_session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[game]

locale="zh"
locale_debug_keys=false

[internationalization]

locale/translations=PackedStringArray("res://data/localization/ui.en.translation", "res://data/localization/ui.zh.translation", "res://data/localization/ui.de.translation", "res://data/localization/ui.ru.translation", "res://data/localization/ui.es.translation", "res://data/localization/combat.en.translation", "res://data/localization/combat.zh.translation", "res://data/localization/combat.de.translation", "res://data/localization/combat.ru.translation", "res://data/localization/combat.es.translation", "res://data/localization/abilities.en.translation", "res://data/localization/abilities.zh.translation", "res://data/localization/abilities.de.translation", "res://data/localization/abilities.ru.translation", "res://data/localization/abilities.es.translation", "res://data/localization/events_general.en.translation", "res://data/localization/events_general.zh.translation", "res://data/localization/events_general.de.translation", "res://data/localization/events_general.ru.translation", "res://data/localization/events_general.es.translation", "res://data/localization/events_season.en.translation", "res://data/localization/events_season.zh.translation", "res://data/localization/events_season.de.translation", "res://data/localization/events_season.ru.translation", "res://data/localization/events_season.es.translation", "res://data/localization/events_year.en.translation", "res://data/localization/events_year.zh.translation", "res://data/localization/events_year.de.translation", "res://data/localization/events_year.ru.translation", "res://data/localization/events_year.es.translation")
